{
  "schemaVersion": 1,
  "applications": [
    {
      "id": "web",
      "stack": "react-vite",
      "path": "apps/web",
      "componentSets": [
        "data-table",
        "react-hook-form"
      ]
    },
    {
      "id": "api",
      "stack": "node",
      "path": "apps/server"
    }
  ],
  "datastores": [
    {
      "id": "platform",
      "engine": "sqlite",
      "path": "packages/database",
      "consumers": [
        "api"
      ]
    }
  ],
  "modules": [
    {
      "id": "observability",
      "path": "packages/observability"
    },
    {
      "id": "contracts",
      "path": "packages/contracts"
    }
  ],
  "profiles": []
}
