{
  "schemaVersion": 1,
  "id": "architecture",
  "version": "3.4.2",
  "description": "Selectable application architecture assets; apps and stores are instantiated only from project choices.",
  "stacks": {
    "react-vite": {
      "kind": "web",
      "language": "typescript",
      "template": "stacks/frontend/react-vite",
      "targets": [
        "web"
      ],
      "ui": "shadcn"
    },
    "react-next": {
      "kind": "web",
      "language": "typescript",
      "template": "stacks/frontend/react-next",
      "targets": [
        "web"
      ],
      "ui": "shadcn"
    },
    "node": {
      "kind": "api",
      "language": "javascript",
      "template": "stacks/backend/node",
      "targets": [
        "server"
      ]
    },
    "go": {
      "kind": "api",
      "language": "go",
      "template": "stacks/backend/go",
      "targets": [
        "server"
      ]
    },
    "tauri": {
      "kind": "desktop",
      "language": "rust+typescript",
      "template": "stacks/frontend/tauri",
      "targets": [
        "mac-arm64",
        "mac-x64",
        "win-x64",
        "win-arm64",
        "linux-x64",
        "linux-arm64"
      ],
      "ui": "shadcn"
    },
    "node-ts": {
      "kind": "api",
      "language": "typescript",
      "template": "stacks/backend/node-ts",
      "targets": [
        "server"
      ]
    }
  },
  "databases": {
    "postgres": {
      "template": "stacks/database/postgres"
    },
    "sqlite": {
      "template": "stacks/database/sqlite"
    }
  },
  "modules": {
    "observability": {
      "template": "modules/observability",
      "workspaceTemplate": "modules/workspace-observability"
    },
    "contracts": {
      "template": "modules/contracts",
      "workspaceTemplate": "modules/workspace-contracts"
    },
    "runtime-assets": {
      "template": "modules/runtime-assets"
    },
    "plugins": {
      "template": "modules/plugins"
    },
    "domain": {
      "template": "modules/workspace-domain",
      "requiresWorkspace": true
    },
    "api-client": {
      "template": "modules/workspace-api-client",
      "requiresWorkspace": true
    },
    "query": {
      "template": "modules/workspace-query",
      "requiresWorkspace": true
    },
    "platform": {
      "template": "modules/workspace-platform",
      "requiresWorkspace": true
    },
    "config": {
      "template": "modules/workspace-config",
      "requiresWorkspace": true
    },
    "auth": {
      "template": "modules/open-source/auth",
      "requiresWorkspace": true
    },
    "auth-client": {
      "template": "modules/open-source/auth-client",
      "requiresWorkspace": true
    },
    "authorization": {
      "template": "modules/open-source/authorization",
      "requiresWorkspace": true
    },
    "jobs": {
      "template": "modules/open-source/jobs",
      "requiresWorkspace": true
    },
    "i18n": {
      "template": "modules/open-source/i18n",
      "requiresWorkspace": true
    },
    "logging": {
      "template": "modules/open-source/logging",
      "requiresWorkspace": true
    },
    "telemetry": {
      "template": "modules/open-source/telemetry",
      "requiresWorkspace": true
    },
    "api-mocks": {
      "template": "modules/open-source/api-mocks",
      "requiresWorkspace": true
    }
  },
  "profiles": {
    "private": {
      "template": "profiles/private"
    }
  },
  "standards": [
    "directories",
    "application-boundaries",
    "ui",
    "contracts",
    "data",
    "observability",
    "delivery",
    "upgrades"
  ],
  "componentSets": "components/shadcn/component-sets.json",
  "blueprints": {
    "admin-api": {
      "template": "blueprints/admin-api.json"
    },
    "fullstack": {
      "template": "blueprints/fullstack.json"
    },
    "web-desktop": {
      "template": "blueprints/web-desktop.json"
    },
    "local-private": {
      "template": "blueprints/local-private.json"
    }
  },
  "fileStorage": {
    "runtimes": [
      "node",
      "go"
    ],
    "providers": {
      "local": {
        "sdk": "standard-library"
      },
      "s3": {
        "sdk": "aws-sdk"
      },
      "aliyun-oss": {
        "sdk": "aliyun-native"
      },
      "tencent-cos": {
        "sdk": "tencent-native"
      }
    },
    "defaultPath": "packages/storage",
    "configuration": "fileStorage"
  },
  "openSourceCatalog": "open-source-catalog.json"
}
