{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
          },
          "stack": {
            "enum": [
              "react-vite",
              "react-next",
              "node",
              "go",
              "tauri",
              "node-ts"
            ]
          },
          "sourceDir": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ui": {
                "type": "string",
                "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
              },
              "dataTable": {
                "type": "string",
                "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
              },
              "forms": {
                "type": "string",
                "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
              },
              "selectors": {
                "type": "string",
                "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
              },
              "feedback": {
                "type": "string",
                "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
              },
              "advanced": {
                "type": "string"
              }
            },
            "required": []
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "componentSets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "data-table",
                "forms",
                "react-hook-form",
                "selectors",
                "dates",
                "feedback",
                "uploads",
                "editor",
                "charts",
                "sortable",
                "flow",
                "virtual-table",
                "auth",
                "job-status"
              ]
            }
          }
        },
        "required": [
          "id",
          "path",
          "stack"
        ]
      }
    },
    "datastores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
          },
          "engine": {
            "enum": [
              "postgres",
              "sqlite"
            ]
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "access": {
            "const": "prisma"
          }
        },
        "required": [
          "id",
          "path",
          "engine",
          "consumers"
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "observability",
              "contracts",
              "runtime-assets",
              "plugins",
              "domain",
              "api-client",
              "query",
              "platform",
              "config",
              "auth",
              "auth-client",
              "authorization",
              "jobs",
              "i18n",
              "logging",
              "telemetry",
              "api-mocks"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "datastore": {
                "type": "string"
              },
              "provider": {
                "enum": [
                  "pg-boss",
                  "bullmq"
                ]
              },
              "backend": {
                "enum": [
                  "postgres",
                  "redis"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "path"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "const": "private"
          },
          "path": {
            "type": "string",
            "pattern": "^(apps|packages|db|infra|tooling)/[^\\\\]+$"
          },
          "edition": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "denyPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "path",
          "edition",
          "environment",
          "applications",
          "denyPatterns"
        ]
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageManager": {
          "type": "string",
          "pattern": "^pnpm@10\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "packageManager"
      ]
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "admin-api",
            "fullstack",
            "web-desktop",
            "local-private"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tasks"
        },
        "api": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "api",
        "datastore"
      ]
    },
    "fileStorage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^packages/"
        },
        "runtime": {
          "enum": [
            "node",
            "go"
          ]
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "defaultStore": {
          "type": "string"
        },
        "stores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,64}$"
              },
              "provider": {
                "enum": [
                  "local",
                  "s3",
                  "aliyun-oss",
                  "tencent-cos"
                ]
              },
              "envPrefix": {
                "type": "string",
                "pattern": "^[_A-Z][A-Z0-9_]{1,63}$"
              }
            },
            "required": [
              "id",
              "provider",
              "envPrefix"
            ]
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "datastore": {
              "type": "string"
            }
          },
          "required": [
            "datastore"
          ]
        },
        "uploadApplications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "consumers",
        "defaultStore",
        "stores"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "applications"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "workspace"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "workspace"
              ]
            },
            {
              "required": [
                "blueprint"
              ]
            },
            {
              "required": [
                "example"
              ]
            }
          ]
        },
        "properties": {
          "datastores": {
            "items": {
              "not": {
                "required": [
                  "access"
                ]
              }
            }
          },
          "modules": {
            "items": {
              "properties": {
                "id": {
                  "enum": [
                    "contracts",
                    "observability",
                    "runtime-assets",
                    "plugins"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
