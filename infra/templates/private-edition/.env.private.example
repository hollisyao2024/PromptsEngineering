NODE_ENV=production
XIAOLAN_EDITION=private
HOST=0.0.0.0
PORT=4100
XIAOLAN_PRIVATE_SERVER_URL=http://127.0.0.1:4100
XIAOLAN_PRIVATE_CORS_ORIGINS=http://127.0.0.1:4100
XIAOLAN_PRIVATE_LICENSE_REQUIRED=1
XIAOLAN_PRIVATE_LICENSE_PUBLIC_KEY_FILE=/opt/xiaolan-private/license-public-key.pem
XIAOLAN_PRIVATE_LICENSE_REQUIRED_ISSUER_ENV=production
XIAOLAN_PRIVATE_LICENSE_ALLOWED_KEY_IDS=xiaolan-license-prod-v1
XIAOLAN_PRIVATE_DEPLOYMENT_ID_FILE=/opt/xiaolan-private/deployment-id

DB_PATH=./data/xiaolan-private.db
# SaaS/Private share the same Automation Skill Platform schema and migration modes.
# Use the forced-RLS app role here; the owner URL is only for the offline backfill command.
PLATFORM_DATABASE_URL=
PLATFORM_DATABASE_SSL=verify-full
IDENTITY_SUBJECT_HMAC_SECRET=
AUTOMATION_SKILL_MIGRATION_MODE=legacy
# 一键安装器会在首次安装时生成以下密钥；手工部署时必须填入至少 32 字符的随机值。
JWT_SECRET=
PRIVATE_JWT_SECRET=
ADMIN_JWT_SECRET=

XIAOLAN_PRIVATE_ADMIN_USERNAME=admin
XIAOLAN_PRIVATE_ADMIN_PASSWORD=
XIAOLAN_PRIVATE_ADMIN_DISPLAY_NAME=企业管理员

# 模型 Provider 默认留空，安装完成后在企业版 Admin 中配置。
XIAOLAN_PRIVATE_MODEL_PROVIDER=
XIAOLAN_PRIVATE_MODEL_NAME=
XIAOLAN_PRIVATE_MODEL_BASE_URL=
XIAOLAN_PRIVATE_MODEL_API_KEY=
XIAOLAN_PRIVATE_MODEL_ID=

XIAOLAN_PRIVATE_MODEL_ASSETS_DIR=/opt/xiaolan-private/model-assets
XIAOLAN_PRIVATE_MODEL_ASSET_UPLOAD_DIR=/opt/xiaolan-private/model-asset-uploads
XIAOLAN_PRIVATE_CLIENT_UPDATES_DIR=/opt/xiaolan-private/client-updates
XIAOLAN_PRIVATE_CLIENT_UPDATE_UPLOAD_DIR=/opt/xiaolan-private/client-update-uploads
XIAOLAN_PRIVATE_EXPORT_DIR=/opt/xiaolan-private/shared/exports
XIAOLAN_PRIVATE_BACKUP_DIR=/opt/xiaolan-private/backups
XIAOLAN_PRIVATE_MODEL_ASSET_DOWNLOAD_ENABLED=1
XIAOLAN_PRIVATE_MODEL_ASSET_SIGNATURE_REQUIRED=1
XIAOLAN_PRIVATE_MODEL_ASSET_SIGNATURE_PUBLIC_KEY_FILE=/opt/xiaolan-private/model-asset-public-key.pem
