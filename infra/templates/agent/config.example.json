{
  "_configNotice": "Project overrides belong in agent.config.json. If this file is the template example under infra/templates/agent/, it is template-owned and may be overwritten by template updates; if initialized as agent.config.json, edit it for project customization.",
  "projectName": "portable-agent-template",
  "baseBranch": "main",
  "packageManager": "pnpm",
  "containerDirs": {
    "worktrees": "../worktrees",
    "tmp": "../tmp",
    "cache": "../cache",
    "artifacts": "../artifacts"
  },
  "containerRetention": {
    "tmpDays": 7,
    "privateReleaseKeep": 2,
    "prArtifactDays": 7
  },
  "commands": {
    "lint": "pnpm run lint",
    "typecheck": "pnpm run type-check",
    "test": "pnpm test",
    "build": "pnpm run build",
    "qaGenerate": "pnpm run qa:generate",
    "qaVerify": "pnpm run qa:verify",
    "qaMerge": "pnpm run qa:merge"
  },
  "qa": {
    "projectChecks": []
  },
  "tdd": {
    "projectChecks": [],
    "migrationRegistry": {
      "registryFile": "",
      "filePattern": "^\\d{3}_[a-z0-9_]+\\.(?:[cm]?[jt]s)$"
    }
  },
  "paths": {
    "primaryApp": "",
    "appDirs": [],
    "webAppDir": "",
    "databaseDir": "",
    "prismaSchema": "",
    "migrationsDir": "",
    "e2eDir": "e2e",
    "perfDir": "perf",
    "securityDir": "security"
  },
  "worktree": {
    "defaultForChanges": true,
    "copyStrategy": "full-checkout",
    "envSymlinks": [".env.local"],
    "sharedConfigSymlinks": [
      ".codex/config.toml",
      ".claude/settings.json",
      ".gemini/settings.json"
    ],
    "sessionDir": "../tmp/worktree-sessions",
    "lockDir": "../tmp/agent-locks",
    "leaseTtlMinutes": 1440,
    "bootstrap": {
      "mode": "skip",
      "alwaysRun": false,
      "command": "",
      "checkCommand": "",
      "lockName": "worktree-bootstrap",
      "timeoutMs": 600000
    }
  },
  "automation": {
    "defaultExecutor": "codex",
    "autoPush": true,
    "autoPr": true,
    "autoMerge": false
  },
  "template": {
    "manifest": "infra/templates/agent/template.manifest.json",
    "applyReportDir": "../tmp/template-apply-reports",
    "sourceRepo": ""
  },
  "release": {
    "bumpVersion": false,
    "versionFile": "package.json",
    "updateChangelog": false,
    "changelogFile": "CHANGELOG.md",
    "createTag": false,
    "tagPrefix": "v"
  },
  "app": {
    "commands": {
      "dev": {
        "mac": {
          "default": "pnpm dev:app:mac",
          "private": "pnpm private:dev:app:mac"
        },
        "win": {
          "default": "pnpm dev:app:win",
          "private": "pnpm private:dev:app:win"
        },
        "ios": {
          "default": "pnpm dev:app:ios",
          "private": "pnpm private:dev:app:ios"
        },
        "android": {
          "default": "pnpm dev:app:android",
          "private": "pnpm private:dev:app:android"
        }
      },
      "build": {
        "mac": {
          "default": "pnpm build:app:mac",
          "private": "pnpm private:build:app:mac"
        },
        "win": {
          "default": "pnpm build:app:win",
          "private": "pnpm private:build:app:win"
        },
        "ios": {
          "default": "pnpm build:app:ios",
          "private": "pnpm private:build:app:ios"
        },
        "android": {
          "default": "pnpm build:app:android",
          "private": "pnpm private:build:app:android"
        }
      }
    }
  },
  "devServer": {
    "portStart": 3000,
    "portEnd": 3099,
    "appDir": "",
    "buildPackages": [],
    "command": "",
    "commands": {
      "start": {
        "default": "pnpm dev:start",
        "private": "pnpm private:start"
      },
      "restart": {
        "default": "pnpm dev:restart",
        "private": "pnpm private:restart"
      },
      "stop": {
        "default": "pnpm dev:stop",
        "private": "pnpm private:stop"
      },
      "status": {
        "default": "pnpm dev:status",
        "private": "pnpm private:status"
      },
      "logs": {
        "default": "pnpm dev:logs",
        "private": "pnpm private:logs"
      }
    }
  },
  "devops": {
    "deployEnabled": false,
    "framework": "custom",
    "appDir": "",
    "databaseDir": "",
    "buildCommand": "",
    "startCommand": "",
    "healthCheckPath": "/",
    "commands": {
      "build": {
        "dev": "pnpm build:dev",
        "staging": "pnpm build:staging",
        "production": "pnpm build:prod",
        "private": {
          "dev": "pnpm private:build:dev",
          "staging": "pnpm private:build:staging",
          "production": "pnpm private:build:prod"
        }
      },
      "ship": {
        "dev": "",
        "staging": "",
        "production": ""
      },
      "cd": {
        "staging": "",
        "production": ""
      },
      "ciRun": "",
      "ciStatus": "",
      "envCheck": {
        "dev": "",
        "staging": "",
        "production": ""
      },
      "envStatus": ""
    },
    "workflows": {
      "ci": "",
      "staging": "",
      "production": ""
    },
    "healthCheck": {
      "dev": "",
      "staging": "",
      "production": ""
    },
    "environments": {
      "dev": {},
      "staging": {},
      "production": {}
    }
  },
  "cron": {
    "enabled": false,
    "registry": []
  },
  "features": {
    "devopsDeploy": false
  }
}
